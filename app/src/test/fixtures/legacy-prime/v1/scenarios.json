          { "line": 2, "type": "message_start", "classification": "core" },
          { "line": 3, "type": "message_update", "classification": "core" },
          { "line": 4, "type": "agent_end", "classification": "core" },
          { "line": 5, "type": "message_end", "classification": "core" }
