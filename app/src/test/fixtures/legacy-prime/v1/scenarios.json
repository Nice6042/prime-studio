          { "line": 2, "type": "turn_start", "classification": "core" },
          { "line": 3, "type": "message_start", "classification": "core" },
          { "line": 4, "type": "message_update", "classification": "core" },
          { "line": 5, "type": "message_end", "classification": "core" },
          { "line": 6, "type": "tool_execution_start", "classification": "core" },
          { "line": 7, "type": "tool_execution_update", "classification": "core" },
          { "line": 8, "type": "tool_execution_end", "classification": "core" },
          { "line": 9, "type": "turn_end", "classification": "core" },
          { "line": 10, "type": "response", "classification": "core" },
          { "line": 11, "type": "error", "classification": "core" },
          { "line": 12, "type": "extension_ui_request", "classification": "extension" },
          { "line": 13, "type": "extension_ui_response", "classification": "extension" },
          { "line": 14, "type": "rlm_child_update", "classification": "extension" },
          { "line": 15, "type": "child_usage_attributed", "classification": "extension" },
